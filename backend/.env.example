# Sao chép thành .env và điền giá trị thật (LẤY TỪ DASHBOARD, KHÔNG commit lên git)

# --- Supabase (Settings → API) ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=         # KHÓA BÍ MẬT — chỉ dùng ở Edge Functions/backend
SUPABASE_ANON_KEY=                 # khóa public — dùng ở client (Mini App) để gọi /menu

# --- Zalo (developers.zalo.me → App của bạn) ---
ZALO_APP_ID=
ZALO_APP_SECRET=                   # để đổi token SĐT → số thật (chỉ ở backend)

# --- Admin menu (hướng $0, không cần API iPOS) ---
ADMIN_TOKEN=                       # mật khẩu để vào trang admin/index.html (đặt chuỗi ngẫu nhiên dài)

# --- iPOS (TUỲ CHỌN — chỉ cần khi mua Menu/CRM API trả phí, dùng cho sync-menu) ---
IPOS_API_BASE=
IPOS_API_KEY=
